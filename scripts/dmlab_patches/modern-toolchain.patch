diff --git a/BUILD b/BUILD
index 771b7e2..cbc199a 100644
--- a/BUILD
+++ b/BUILD
@@ -784,7 +784,12 @@ genrule(
         CODE_DIR + "/q3_ui/ui.qvm",
     ],
     outs = ["baselab/vm.pk3"],
-    cmd = "A=$$(pwd); mkdir $(@D)/vm; ln -s -r -t $(@D)/vm -- $(SRCS); (cd $(@D); zip --quiet -r $${A}/$(OUTS) -- vm)",
+    # mkdir -p / ln -sf, not mkdir / ln -s: with --spawn_strategy=local (required in this
+    # container -- no user namespaces for sandboxing), genrules run directly in the real output
+    # tree instead of a fresh sandbox, so a leftover baselab/vm/ and its symlinks from an
+    # earlier build of this same genrule (e.g. while building the deepmind_lab.so pip package)
+    # make a second run's plain `mkdir`/`ln -s` fail outright on the "already exists" case.
+    cmd = "A=$$(pwd); mkdir -p $(@D)/vm; ln -s -f -r -t $(@D)/vm -- $(SRCS); (cd $(@D); zip --quiet -r $${A}/$(OUTS) -- vm)",
     visibility = ["//testing:__subpackages__"],
 )
 
